# ============================
# Manim Project .gitignore
# ============================

# Manim generated media (videos, images, cache)
media/

# Manim temporary files (older versions)
manimlib/media/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
env/
.venv/
.env/

# PyCharm project settings
.idea/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# macOS system files
.DS_Store

# Logs
*.log

# dotenv files (if used)
*.env
